
# Firebase Project Configuration
# Copy this file to .env.local and fill in your Firebase project credentials.
# You can find these in your Firebase project settings:
# Project settings > General > Your apps > Firebase SDK snippet > Config

NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_AUTH_DOMAIN
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_STORAGE_BUCKET
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_APP_ID
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID

# Firebase Admin SDK (for server-side operations like webhooks)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# MITO/Furp API Configuration
# Get these credentials from your MITO dashboard
NEXT_PUBLIC_MITO_BASE_URL=https://furp02-staging.funtechcom.com/api/v1
MITO_API_KEY=your_mito_api_key_here
MITO_USERNAME=your_mito_username_here
MITO_PASSWORD=your_mito_password_here
MITO_ACCESS_SERVICE_NUMBER=
MITO_ACCESS_AFFILIATE_NUMBER=

# MITO Configuration
# The Upesi beneficiary ID where all payments will be sent
MITO_BENEFICIARY_ID=your_upesi_beneficiary_id_here
# The MITO user ID for API calls
MITO_USER_ID=your_mito_user_id_here

# MITO Webhook Configuration
MITO_WEBHOOK_SECRET=your_webhook_secret_here
# Base URL of your application (for redirects and webhooks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment
NODE_ENV=
